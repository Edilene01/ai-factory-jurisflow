# ---------------------------------------------------------------------------
# Modelo de variáveis de ambiente. Copie para .env e preencha localmente.
# Nenhum valor real entra neste arquivo, e o .env está no .gitignore.
# Em produção e em desenvolvimento os valores vivem nos secrets da plataforma,
# nunca dentro do repositório.
# ---------------------------------------------------------------------------

# Assinatura que o formulário do site envia no header X-Jurisflow-Signature.
# Gere com: openssl rand -hex 32
JURISFLOW_WEBHOOK_SECRET=

# Provedor de LLM. Confirme o identificador do modelo na documentação vigente
# do provedor antes de fixar o valor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback de provedor, previsto para a Etapa 2.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Slack do workspace JurisFlow (escopo chat:write nos canais de triagem).
SLACK_BOT_TOKEN=

# Banco do n8n e da trilha de auditoria (Etapa 2).
PGHOST=
PGPORT=5432
PGDATABASE=jurisflow
PGUSER=
PGPASSWORD=

# Mesma conexão em formato de URL, usada pelos scripts de retenção:
#   psql "$DATABASE_URL" -f db/retencao/purga_diaria.sql
DATABASE_URL=

# ---------------------------------------------------------------------------
# Retenção de dados pessoais. Primeira barreira da política descrita em
# docs/lgpd/politica-retencao-exclusao.md. Precisa estar definida em TODOS os
# ambientes, e não só no docker-compose local: sem a primeira linha, todo intake
# atendido com sucesso deixa nome, CPF e relato gravados no banco.
# ---------------------------------------------------------------------------
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72

# Acesso à API do n8n, usado pelo deploy automatizado.
N8N_PUBLIC_URL=
N8N_API_KEY=

# Operação
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
